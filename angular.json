{
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "indem-clever-mfe": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/indem-clever",
      "sourceRoot": "projects/indem-clever/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "outputPath": "dist/indem-clever-mfe",
            "index": "projects/indem-clever/src/index.html",
            "main": "projects/indem-clever/src/main.ts",
            "tsConfig": "projects/indem-clever/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "sb-ui-seguros-bolivar.min.css",
                "input": "node_modules/@seguros-bolivar/ui-bundle/dist",
                "output": "/assets/sb-ui"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@seguros-bolivar/ui-bundle/dist/fonts",
                "output": "/assets/sb-ui/fonts"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@seguros-bolivar/ui-bundle/dist/webfonts",
                "output": "/assets/sb-ui/webfonts"
              }
            ],
            "styles": [
              "node_modules/primeicons/primeicons.css",
              "projects/indem-clever/src/tailwind.css",
              "projects/indem-clever/src/styles.scss"
            ],
            "scripts": [
              "node_modules/@seguros-bolivar/ui-bundle/dist/sb-ui-seguros-bolivar.min.js"
            ],
            "extraWebpackConfig": "projects/indem-clever/webpack.config.js",
            "commonChunk": false
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all",
              "extraWebpackConfig": "projects/indem-clever/webpack.prod.config.js"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "tsConfig": "projects/indem-clever/tsconfig.app.dev.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "options": {
            "port": 4202,
            "publicHost": "http://localhost:4202",
            "extraWebpackConfig": "projects/indem-clever/webpack.config.js",
            "proxyConfig": "projects/indem-clever/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "indem-clever-mfe:build:production",
              "extraWebpackConfig": "projects/indem-clever/webpack.prod.config.js"
            },
            "development": {
              "buildTarget": "indem-clever-mfe:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
