{
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "dim-asignacion-mfe": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/dim-asignacion",
      "sourceRoot": "projects/dim-asignacion/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "outputPath": "dist/dim-asignacion-mfe",
            "index": "projects/dim-asignacion/src/index.html",
            "main": "projects/dim-asignacion/src/main.ts",
            "tsConfig": "projects/dim-asignacion/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [],
            "styles": [
              "node_modules/primeicons/primeicons.css",
              "projects/dim-asignacion/src/tailwind.css",
              "projects/dim-asignacion/src/styles.scss"
            ],
            "extraWebpackConfig": "projects/dim-asignacion/webpack.config.js",
            "commonChunk": false
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all",
              "extraWebpackConfig": "projects/dim-asignacion/webpack.prod.config.js"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "tsConfig": "projects/dim-asignacion/tsconfig.app.dev.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "options": {
            "port": 4202,
            "publicHost": "http://localhost:4202",
            "extraWebpackConfig": "projects/dim-asignacion/webpack.config.js"
          },
          "configurations": {
            "production": {
              "buildTarget": "dim-asignacion-mfe:build:production",
              "extraWebpackConfig": "projects/dim-asignacion/webpack.prod.config.js"
            },
            "development": {
              "buildTarget": "dim-asignacion-mfe:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
